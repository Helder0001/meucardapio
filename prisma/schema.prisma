generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  customDomain       String?            @unique
  plan               Plan               @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  logo               String?
  primaryColor       String?            @default("#f97316")
  secondaryColor     String?
  phone              String?
  email              String?
  cnpj               String?
  address            Json?
  settings           Json               @default("{}")
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  addons             Addon[]
  addonGroups        AddonGroup[]
  auditLogs          AuditLog[]
  businessHours      BusinessHour[]
  cashbackConfig     CashbackConfig?
  categories         Category[]
  coupons            Coupon[]
  customers          Customer[]
  deliveryZones      DeliveryZone[]
  loyaltyConfig      LoyaltyConfig?
  notifications      Notification[]
  orders             Order[]
  pdvs               PDV[]
  payments           Payment[]
  printers           Printer[]
  products           Product[]
  reviews            Review[]
  subscription       Subscription?
  users              User[]
  whatsappConfig     WhatsappConfig?

  @@index([slug])
  @@index([customDomain])
  @@index([isActive])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  mercadoPagoSubId   String?            @unique
  plan               Plan
  status             SubscriptionStatus
  amount             Decimal            @db.Decimal(10, 2)
  currency           String             @default("BRL")
  currentPeriodStart DateTime           @map("billingCycleStart")
  currentPeriodEnd   DateTime           @map("billingCycleEnd")
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
}

model User {
  id                String         @id @default(cuid())
  tenantId          String?
  name              String
  email             String
  passwordHash      String
  role              UserRole       @default(ATTENDANT)
  phone             String?
  avatar            String?
  isActive          Boolean        @default(true)
  mfaSecret         String?
  mfaEnabled        Boolean        @default(false)
  mfaBackupCodes    String[]       @default([])
  lastLoginAt       DateTime?
  lastLoginIp       String?
  passwordChangedAt DateTime?
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  refreshTokenHash  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]
  ordersCreated     Order[]        @relation("CreatedBy")
  ordersAsWaiter    Order[]        @relation("AssignedWaiter")
  pdvAccess         PDVUser[]
  tableSessions     TableSession[]
  tenant            Tenant?        @relation(fields: [tenantId], references: [id])

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
}

model PDV {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  type      String     @default("STORE")
  address   Json?
  isActive  Boolean    @default(true)
  settings  Json       @default("{}")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cashFlows CashFlow[]
  orders    Order[]
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  users     PDVUser[]
  stocks    Stock[]
  tables    Table[]

  @@index([tenantId])
}

model PDVUser {
  pdvId  String
  userId String
  pdv    PDV    @relation(fields: [pdvId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([pdvId, userId])
}

model CashFlow {
  id        String   @id @default(cuid())
  tenantId  String
  pdvId     String
  type      String
  amount    Decimal  @db.Decimal(10, 2)
  notes     String?
  userId    String
  createdAt DateTime @default(now())
  pdv       PDV      @relation(fields: [pdvId], references: [id])

  @@index([pdvId])
  @@index([tenantId])
}

model Table {
  id        String         @id @default(cuid())
  tenantId  String
  pdvId     String
  number    Int
  sector    String
  capacity  Int            @default(4)
  status    TableStatus    @default(AVAILABLE)
  qrCode    String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  orders    Order[]
  pdv       PDV            @relation(fields: [pdvId], references: [id])
  sessions  TableSession[]

  @@unique([pdvId, number])
  @@index([tenantId])
  @@index([qrCode])
}

model TableSession {
  id          String    @id @default(cuid())
  tenantId    String
  tableId     String
  waiterId    String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  totalAmount Decimal?  @db.Decimal(10, 2)
  notes       String?
  orders      Order[]
  table       Table     @relation(fields: [tableId], references: [id])
  waiter      User?     @relation(fields: [waiterId], references: [id])

  @@index([tenantId])
  @@index([tableId])
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@index([tenantId])
}

model Product {
  id              String              @id @default(cuid())
  tenantId        String
  categoryId      String
  name            String
  description     String?
  ingredients     String[]
  price           Decimal             @db.Decimal(10, 2)
  comparePrice    Decimal?            @db.Decimal(10, 2)
  image           String?
  images          String[]
  sku             String?
  isFeatured      Boolean             @default(false)
  isBestSeller    Boolean             @default(false)
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  soldCount       Int                 @default(0)
  preparationTime Int?
  tags            String[]
  aiDescription   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  orderItems      OrderItem[]
  category        Category            @relation(fields: [categoryId], references: [id])
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  addonGroups     ProductAddonGroup[]
  stocks          Stock[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([isActive, tenantId])
}

model AddonGroup {
  id         String              @id @default(cuid())
  tenantId   String
  name       String
  minSelect  Int                 @default(0)
  maxSelect  Int                 @default(1)
  isRequired Boolean             @default(false)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  addons     Addon[]
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  products   ProductAddonGroup[]

  @@index([tenantId])
}

model ProductAddonGroup {
  productId    String
  addonGroupId String
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, addonGroupId])
}

model Addon {
  id              String           @id @default(cuid())
  tenantId        String
  addonGroupId    String
  name            String
  price           Decimal          @default(0) @db.Decimal(10, 2)
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  addonGroup      AddonGroup       @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  orderItemAddons OrderItemAddon[]

  @@index([tenantId])
  @@index([addonGroupId])
}

model Stock {
  id          String   @id @default(cuid())
  tenantId    String
  pdvId       String
  productId   String
  quantity    Decimal  @default(0) @db.Decimal(10, 3)
  minQuantity Decimal? @db.Decimal(10, 3)
  unit        String   @default("UN")
  updatedAt   DateTime @updatedAt
  pdv         PDV      @relation(fields: [pdvId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([pdvId, productId])
  @@index([tenantId])
}

model Customer {
  id              String                @id @default(cuid())
  tenantId        String
  name            String?
  phone           String
  email           String?
  cpf             String?
  address         Json?
  isVerified      Boolean               @default(false)
  verifiedAt      DateTime?
  otpCode         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int                   @default(0)
  loyaltyPoints   Int                   @default(0)
  cashbackBalance Decimal               @default(0) @db.Decimal(10, 2)
  totalOrders     Int                   @default(0)
  totalSpent      Decimal               @default(0) @db.Decimal(10, 2)
  lastOrderAt     DateTime?
  isActive        Boolean               @default(true)
  lgpdConsent     Boolean               @default(false)
  lgpdConsentAt   DateTime?
  anonymizedAt    DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  cashbackTxs     CashbackTransaction[]
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  loyaltyTxs      LoyaltyTransaction[]
  orders          Order[]
  reviews         Review[]

  @@unique([phone, tenantId])
  @@index([tenantId])
  @@index([phone])
}

model Order {
  id                  String               @id @default(cuid())
  tenantId            String
  pdvId               String?
  tableId             String?
  tableSessionId      String?
  customerId          String?
  waiterId            String?
  createdById         String?
  orderNumber         Int
  type                OrderType
  status              OrderStatus          @default(PENDING)
  paymentStatus       PaymentStatus        @default(PENDING)
  notes               String?
  subtotal            Decimal              @db.Decimal(10, 2)
  deliveryFee         Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  cashbackUsed        Decimal              @default(0) @db.Decimal(10, 2)
  total               Decimal              @db.Decimal(10, 2)
  couponId            String?
  couponCode          String?
  couponDiscount      Decimal?             @db.Decimal(10, 2)
  deliveryAddress     Json?
  deliveryBairro      String?
  estimatedDeliveryAt DateTime?
  changeFor           Decimal?             @db.Decimal(10, 2)
  confirmedAt         DateTime?
  preparingAt         DateTime?
  readyAt             DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  createdBy           User?                @relation("CreatedBy", fields: [createdById], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  pdv                 PDV?                 @relation(fields: [pdvId], references: [id])
  table               Table?               @relation(fields: [tableId], references: [id])
  tableSession        TableSession?        @relation(fields: [tableSessionId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  waiter              User?                @relation("AssignedWaiter", fields: [waiterId], references: [id])
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  review              Review?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([pdvId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String           @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  productPrice Decimal          @db.Decimal(10, 2)
  quantity     Int
  unitPrice    Decimal          @db.Decimal(10, 2)
  totalPrice   Decimal          @db.Decimal(10, 2)
  notes        String?
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product          @relation(fields: [productId], references: [id])
  addons       OrderItemAddon[]

  @@index([orderId])
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  addonId     String
  addonName   String
  addonPrice  Decimal   @db.Decimal(10, 2)
  addon       Addon     @relation(fields: [addonId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  userId    String?
  notes     String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  orderId           String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  mercadoPagoId     String?       @unique
  mercadoPagoStatus String?
  pixQrCode         String?
  pixQrCodeBase64   String?
  pixExpiresAt      DateTime?
  installments      Int?
  cardLastDigits    String?
  changeAmount      Decimal?      @db.Decimal(10, 2)
  webhookData       Json?
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  refundAmount      Decimal?      @db.Decimal(10, 2)
  refundReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id])
  tenant            Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([mercadoPagoId])
  @@index([status])
}

model DeliveryZone {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  name      String?
  bairro    String?
  cepStart  String?
  cepEnd    String?
  radiusKm  Decimal? @db.Decimal(6, 2)
  fee       Decimal  @default(0) @db.Decimal(10, 2)
  freeAbove Decimal? @db.Decimal(10, 2)
  minOrder  Decimal? @db.Decimal(10, 2)
  maxTime   Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Coupon {
  id                    String     @id @default(cuid())
  tenantId              String
  code                  String
  description           String?
  type                  CouponType
  value                 Decimal    @db.Decimal(10, 2)
  minOrderValue         Decimal?   @db.Decimal(10, 2)
  maxDiscount           Decimal?   @db.Decimal(10, 2)
  usageLimit            Int?
  usageCount            Int        @default(0)
  usageLimitPerCustomer Int        @default(1)
  startsAt              DateTime?
  expiresAt             DateTime?
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  tenant                Tenant     @relation(fields: [tenantId], references: [id])
  orders                Order[]

  @@unique([code, tenantId])
  @@index([tenantId])
}

model LoyaltyConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  pointsPerReal   Decimal  @default(1) @db.Decimal(10, 2)
  redeemEvery     Int      @default(100)
  redeemValue     Decimal  @default(5) @db.Decimal(10, 2)
  minPointsRedeem Int      @default(100)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

model LoyaltyTransaction {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String
  orderId     String?
  type        String
  points      Int
  balance     Int
  description String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

model CashbackConfig {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  percentage    Decimal  @db.Decimal(5, 2)
  validityDays  Int      @default(30)
  maxCashback   Decimal? @db.Decimal(10, 2)
  minOrderValue Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model CashbackTransaction {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  orderId    String?
  type       String
  amount     Decimal   @db.Decimal(10, 2)
  balance    Decimal   @db.Decimal(10, 2)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

model Review {
  id         String    @id @default(cuid())
  tenantId   String
  orderId    String    @unique
  customerId String
  rating     Int
  comment    String?
  ownerReply String?
  repliedAt  DateTime?
  isApproved Boolean   @default(false)
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model BusinessHour {
  id        String  @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  openTime  String
  closeTime String
  isOpen    Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dayOfWeek])
}

model Printer {
  id         String     @id @default(cuid())
  tenantId   String
  pdvId      String?
  name       String
  token      String     @unique
  sector     String
  isActive   Boolean    @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime   @default(now())
  printJobs  PrintJob[]
  tenant     Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([token])
}

model PrintJob {
  id        String    @id @default(cuid())
  printerId String
  orderId   String?
  content   String
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  printedAt DateTime?
  printer   Printer   @relation(fields: [printerId], references: [id])

  @@index([printerId, status])
  @@index([createdAt])
}

model WhatsappConfig {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  evolutionUrl    String
  evolutionApiKey String
  instanceName    String
  status          String    @default("DISCONNECTED")
  qrCode          String?
  lastConnectedAt DateTime?
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String?
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isRead])
  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  resource   String?
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  pdvId      String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

enum Plan {
  STARTER
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum UserRole {
  MASTER_ADMIN
  TENANT_ADMIN
  MANAGER
  ATTENDANT
  WAITER
  DELIVERY_PERSON
}

enum OrderType {
  TABLE
  DELIVERY
  PICKUP
  PDV
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  VOUCHER
  CASHBACK
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

model WhatsappChat {
  id            String    @id @default(cuid())
  tenantId      String
  phone         String
  contactName   String?
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)
  isOpen        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  messages WhatsappMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model WhatsappMessage {
  id        String   @id @default(cuid())
  chatId    String
  body      String
  fromMe    Boolean  @default(false)
  status    String?
  sentById  String?
  createdAt DateTime @default(now())

  chat   WhatsappChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sentBy User?        @relation("SentMessages", fields: [sentById], references: [id])

  @@index([chatId])
}
