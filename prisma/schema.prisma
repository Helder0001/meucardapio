  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════
// HORÁRIOS DE FUNCIONAMENTO
// ══════════════════════════════════════════════════════════

model BusinessHour {
  id        String  @id @default(cuid())
  tenantId  String
  dayOfWeek Int     // 0=Domingo, 1=Segunda, ..., 6=Sábado
  openTime  String  // "11:00"
  closeTime String  // "23:00"
  isOpen    Boolean @default(true)

  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dayOfWeek])
}

// ══════════════════════════════════════════════════════════
// IMPRESSORAS
// ══════════════════════════════════════════════════════════

model Printer {
  id         String    @id @default(cuid())
  tenantId   String
  pdvId      String?
  name       String    // "Cozinha", "Bar", "Balcão"
  token      String    @unique // token de autenticação da impressora
  sector     String    // KITCHEN, BAR, COUNTER
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  printJobs  PrintJob[]

  @@index([tenantId])
  @@index([token])
}

model PrintJob {
  id        String   @id @default(cuid())
  printerId String
  orderId   String?
  content   String   // texto formatado para impressora térmica
  status    String   @default("PENDING") // PENDING, PRINTED, FAILED
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  printedAt DateTime?

  printer   Printer  @relation(fields: [printerId], references: [id])

  @@index([printerId, status])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════
// WHATSAPP (Evolution API)
// ══════════════════════════════════════════════════════════

model WhatsappConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  evolutionUrl    String   // URL da instância do tenant
  evolutionApiKey String   // chave criptografada
  instanceName    String
  status          String   @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING
  qrCode          String?  // QR Code atual para conexão
  lastConnectedAt DateTime?
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

// ══════════════════════════════════════════════════════════
// NOTIFICAÇÕES
// ══════════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?  // null = para todos do tenant
  type      String   // NEW_ORDER, LOW_STOCK, PAYMENT_FAILED, etc.
  title     String
  message   String
  data      Json?    // dados extras (ex: orderId)
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isRead])
  @@index([userId])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════
// AUDITORIA — LOGS IMUTÁVEIS
//
// Regra: nunca deletar ou atualizar registros desta tabela.
// Apenas INSERT. Usar particionamento por data em produção.
// ══════════════════════════════════════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?  // null para ações master
  userId     String?
  action     String   // LOGIN, LOGOUT, CREATE_ORDER, CANCEL_ORDER, UPDATE_PRICE...
  resource   String?  // "orders", "products", "users"
  resourceId String?  // ID do recurso afetado
  oldValue   Json?    // estado anterior
  newValue   Json?    // estado novo
  ip         String?
  userAgent  String?
  pdvId      String?
  metadata   Json?    // dados extras
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model ReportSchedule {
  id          String   @id @default(cuid())
  tenantId    String
  createdById String?
  email       String
  frequency   String   // DAILY | WEEKLY | MONTHLY
  reportType  String   // orders | products
  dayOfWeek   Int?     // 0=dom … 6=sab (para WEEKLY)
  hour        Int      @default(8)
  isActive    Boolean  @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User?  @relation("CreatedSchedules", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([isActive, hour])
}

// ══════════════════════════════════════════════════════════
// MARKETPLACES DE DELIVERY (iFood / 99Food)
//
// Modelo de autorização: a PLATAFORMA (este SaaS) é quem se cadastra e é
// homologada como "app/integrador" no iFood e na 99Food, uma única vez.
// Cada Tenant (restaurante) apenas AUTORIZA o app da plataforma a acessar
// a loja dele — fluxo igual ao MercadoPagoConnection (OAuth), nunca pedimos
// para o lojista colar client_id/client_secret manualmente.
//
// accessToken/refreshToken sempre criptografados em repouso (AES-256-GCM,
// ver lib/security/crypto.ts) — nunca armazenar em texto plano.
// ══════════════════════════════════════════════════════════

model MarketplaceConnection {
  id          String                      @id @default(cuid())
  tenantId    String
  provider    MarketplaceProvider
  status      MarketplaceConnectionStatus @default(PENDING)

  // Identificador da loja na plataforma do marketplace
  // iFood: merchantId (UUID) · 99Food: AppShopID (Open Delivery)
  externalMerchantId String?
  merchantName       String?   // nome da loja como cadastrado no marketplace (auditoria/exibição)

  // Sensível — sempre criptografado (AES-256-GCM). Nulo até a autorização ser concluída.
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenType       String?   @default("bearer")
  scope           String?
  expiresAt       DateTime?

  // Estado usado durante o handshake OAuth (CSRF) — descartado após o callback
  oauthState      String?
  authorizationCodeVerifier String? // iFood usa o fluxo "Authorization Code" com verifier curto (PKCE-like)

  // Repasse de catálogo: liga produtos do cardápio aos itens vendáveis no marketplace
  lastCatalogSyncAt DateTime?
  lastCatalogSyncError String?

  // Operação
  autoAcceptOrders Boolean   @default(false) // aceitar pedidos automaticamente ao chegar
  isOpen           Boolean   @default(true)  // loja aberta para receber pedidos no marketplace
  lastPolledAt     DateTime?                  // última vez que o polling de eventos rodou com sucesso
  lastPollingError String?

  connectedAt       DateTime?
  connectedByUserId String?
  disconnectedAt    DateTime?
  revokedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  orders       MarketplaceOrder[]
  productMappings MarketplaceProductMapping[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([provider, status])
  @@index([externalMerchantId])
}

// Liga um Product do cardápio interno ao item correspondente no catálogo
// do marketplace — necessário porque cada plataforma exige seu próprio
// cadastro de item (nome, categoria, preço podem divergir do cardápio interno).
model MarketplaceProductMapping {
  id           String   @id @default(cuid())
  connectionId String
  productId    String

  // ID do item/sellable no catálogo do marketplace (preenchido após o sync)
  externalItemId String?
  // Preço pode ser diferenciado por canal (comum cobrir taxa do marketplace)
  overridePrice   Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)

  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([connectionId, productId])
  @@index([connectionId])
  @@index([productId])
}

// Um pedido vindo do iFood/99Food. Ao ser processado, gera um Order interno
// normal (type=DELIVERY) — esta tabela guarda o vínculo e os dados brutos
// de origem para rastreabilidade, conciliação financeira e suporte.
model MarketplaceOrder {
  id           String   @id @default(cuid())
  tenantId     String
  connectionId String
  orderId      String?  @unique // Order interno gerado (null até o processamento terminar)

  provider         MarketplaceProvider
  externalOrderId  String              // ID do pedido na plataforma de origem
  externalDisplayId String?             // código curto exibido ao cliente (#1234)
  status           MarketplaceOrderStatus @default(RECEIVED)

  // Snapshot do payload recebido — auditoria e reprocessamento em caso de bug
  rawPayload   Json
  // Eventos já confirmados (acknowledgment) para não reprocessar no próximo polling
  acknowledgedEventIds String[] @default([])

  // Repasse financeiro informado pela plataforma (comissão, taxas, valor líquido)
  grossAmount      Decimal? @db.Decimal(10, 2)
  commissionAmount Decimal? @db.Decimal(10, 2)
  netAmount        Decimal? @db.Decimal(10, 2)

  // Quem faz a entrega: o próprio marketplace (FULL_SERVICE) ou o lojista (MARKETPLACE_DELIVERY)
  deliveredBy String? // MERCHANT | MARKETPLACE

  receivedAt   DateTime  @default(now())
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  syncError    String?   // erro ao tentar transformar em Order interno (visível no dashboard)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  connection MarketplaceConnection @relation(fields: [connectionId], references: [id])
  order      Order?                @relation(fields: [orderId], references: [id])

  @@unique([provider, externalOrderId])
  @@index([tenantId])
  @@index([connectionId])
  @@index([status])
  @@index([receivedAt])
}
