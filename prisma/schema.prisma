// prisma/schema.prisma
//
// MULTI-TENANT: todo modelo que pertence a um estabelecimento
// tem tenantId obrigatório. Nunca faça queries sem filtrar por tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // necessário para migrations no Neon/Supabase
}

// ══════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════

enum Plan {
  PRO   // acesso completo — usuários ilimitados, todos os recursos
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE    // pagamento atrasado
  CANCELLED
  SUSPENDED   // bloqueado por inadimplência
}

enum UserRole {
  MASTER_ADMIN    // acesso à plataforma toda (você)
  TENANT_ADMIN    // dono do restaurante
  MANAGER         // gerente
  ATTENDANT       // atendente/caixa
  STAFF           // operador (ex-garçom) — acesso limitado a pedidos
  DELIVERY_PERSON // entregador
}

enum OrderType {
  TABLE     // pedido na mesa
  DELIVERY  // entrega em domicílio
  PICKUP    // retirada no balcão
  PDV       // balcão/caixa direto
}

enum OrderStatus {
  PENDING           // aguardando confirmação
  CONFIRMED         // confirmado
  PREPARING         // em preparo na cozinha
  READY             // pronto para entrega/retirada
  OUT_FOR_DELIVERY  // saiu para entrega
  DELIVERED         // entregue
  CANCELLED         // cancelado
  REFUNDED          // reembolsado
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  CREDIT_CARD_MANUAL
  DEBIT_CARD
  CASH
  VOUCHER
  CASHBACK
}

enum CouponType {
  PERCENTAGE    // ex: 10% de desconto
  FIXED         // ex: R$ 5,00 de desconto
  FREE_DELIVERY // frete grátis
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

// ── Marketplaces de delivery (iFood, 99Food) ────────────────────────────────
enum MarketplaceProvider {
  IFOOD
  NINETYNINE_FOOD // 99Food
}

enum MarketplaceConnectionStatus {
  PENDING       // aguardando autorização do lojista na plataforma do marketplace
  CONNECTED     // autorizado e operando
  DISCONNECTED  // desconectado manualmente pelo lojista
  ERROR         // token expirado/revogado ou erro persistente — precisa reconectar
}

// Espelha o ciclo de vida do pedido na plataforma de origem (iFood/99Food),
// separado do nosso OrderStatus interno porque os nomes/etapas não coincidem 1:1.
enum MarketplaceOrderStatus {
  RECEIVED            // evento de novo pedido chegou, ainda não confirmado
  CONFIRMED           // confirmamos o pedido na plataforma
  PREPARING
  READY_FOR_PICKUP
  DISPATCHED          // saiu para entrega (entregador do marketplace ou próprio)
  CONCLUDED
  CANCELLED
  CANCELLATION_REQUESTED // cliente/plataforma pediu cancelamento, aguardando decisão do lojista
}

// ══════════════════════════════════════════════════════════
// PLATAFORMA (nivel master)
// ══════════════════════════════════════════════════════════

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique // ex: "pizzaria-do-ze" → /menu/pizzaria-do-ze
  customDomain       String?            @unique // ex: "pedidos.pizzariadoze.com.br"
  plan               Plan               @default(PRO)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?

  // Identidade visual
  logo               String?
  primaryColor       String?            @default("#f97316")
  secondaryColor     String?

  // Dados do estabelecimento
  phone              String?
  email              String?
  cnpj               String?
  address            Json?              // { street, number, district, city, state, zip }

  // Configurações gerais (JSON flexível para evitar migrations frequentes)
  settings           Json               @default("{}")
  // Exemplo de settings:
  // {
  //   "orderMinValue": 20,
  //   "allowScheduledOrders": false,
  //   "manualOpen": null,      // true = forçado aberto, false = forçado fechado, null = automático
  //   "closedMessage": "Voltamos amanhã às 11h!",
  //   "whatsappNotifications": { "onConfirm": true, "onReady": true, "onDelivery": true },
  //   "reviewsEnabled": true
  // }

  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relações
  subscription       Subscription?
  users              User[]
  pdvs               PDV[]
  categories         Category[]
  products           Product[]
  addonGroups        AddonGroup[]
  addons             Addon[]
  customers          Customer[]
  orders             Order[]
  coupons            Coupon[]
  printers           Printer[]
  deliveryZones      DeliveryZone[]
  businessHours      BusinessHour[]
  loyaltyConfig      LoyaltyConfig?
  cashbackConfig     CashbackConfig?
  whatsappConfig     WhatsappConfig?
  mercadoPagoConnection MercadoPagoConnection?
  stripeConnection      StripeConnection?
  efiConnection         EfiConnection?
  whatsappChats      WhatsappChat[]
  reportSchedules    ReportSchedule[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  payments           Payment[]
  reviews            Review[]
  marketplaceConnections MarketplaceConnection[]
  marketplaceOrders      MarketplaceOrder[]

  @@index([slug])
  @@index([customDomain])
  @@index([isActive])
}

enum PaymentProvider {
  MERCADOPAGO
  EFI
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  provider           PaymentProvider    @default(MERCADOPAGO)
  mercadoPagoSubId   String?            @unique
  // Efí Bank (API Cobranças / Assinaturas) — substitui o preapproval do MP
  // para a cobrança recorrente do PRÓPRIO plano PRO da plataforma.
  efiPlanId          Int?
  efiSubscriptionId  Int?               @unique
  efiChargeId        Int?
  plan               Plan
  billingCycle       BillingCycle       @default(MONTHLY)
  status             SubscriptionStatus
  amount             Decimal            @db.Decimal(10, 2)
  currency           String             @default("BRL")
  currentPeriodStart DateTime @map("billingCycleStart")
  currentPeriodEnd   DateTime @map("billingCycleEnd")
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
}

// Cache do plan_id criado na Efí pra cada ciclo de cobrança (mensal/anual).
// A Efí exige criar um "plano" (nome + intervalo + repetições) antes de
// poder vincular assinaturas a ele — criamos uma vez e reaproveitamos.
enum EfiEnvironment {
  SANDBOX
  PRODUCTION
}

model EfiPlan {
  id           String         @id @default(cuid())
  billingCycle BillingCycle
  environment  EfiEnvironment
  efiPlanId    Int
  createdAt    DateTime       @default(now())

  @@unique([billingCycle, environment])
  @@unique([efiPlanId, environment])
}

// ══════════════════════════════════════════════════════════
// USUÁRIOS E ACESSO
// ══════════════════════════════════════════════════════════

model User {
  id                String    @id @default(cuid())
  tenantId          String?   // null apenas para MASTER_ADMIN
  name              String
  email             String
  passwordHash      String
  role              UserRole  @default(ATTENDANT)
  phone             String?
  avatar            String?
  isActive          Boolean   @default(true)

  // MFA
  mfaSecret         String?
  mfaEnabled        Boolean   @default(false)
  mfaBackupCodes    String[]  @default([])

  // Sessão / segurança
  lastLoginAt       DateTime?
  lastLoginIp       String?
  passwordChangedAt DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?

  // Refresh token: guardamos o hash, nunca o token em si
  refreshTokenHash  String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  pdvAccess         PDVUser[]
  ordersCreated     Order[]   @relation("CreatedBy")
  ordersAsWaiter    Order[]   @relation("AssignedWaiter")
  statusHistoryEntries OrderStatusHistory[] @relation("StatusHistoryUser")
  sentMessages         WhatsappMessage[]    @relation("SentMessages")
  createdSchedules     ReportSchedule[]     @relation("CreatedSchedules")
  tableSessions     TableSession[]
  auditLogs         AuditLog[]
  stockMovements    StockMovement[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
}

// ══════════════════════════════════════════════════════════
// MULTI-PDV
// ══════════════════════════════════════════════════════════

model PDV {
  id        String    @id @default(cuid())
  tenantId  String
  name      String    // ex: "Loja Centro", "Delivery", "Quiosque Shopping"
  type      String    @default("STORE") // STORE, DELIVERY, KIOSK
  address   Json?
  isActive  Boolean   @default(true)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  users     PDVUser[]
  tables    Table[]
  orders    Order[]
  stocks    Stock[]
  cashFlows CashFlow[]

  @@index([tenantId])
}

// Tabela de junção: quais usuários têm acesso a quais PDVs
model PDVUser {
  pdvId  String
  userId String
  pdv    PDV    @relation(fields: [pdvId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([pdvId, userId])
}

model CashFlow {
  id        String   @id @default(cuid())
  tenantId  String
  pdvId     String
  type      String   // OPEN, CLOSE, DEPOSIT, WITHDRAWAL
  amount    Decimal  @db.Decimal(10, 2)
  notes     String?
  userId    String
  createdAt DateTime @default(now())

  pdv       PDV      @relation(fields: [pdvId], references: [id])

  @@index([pdvId])
  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════
// MESAS E GARÇOM
// ══════════════════════════════════════════════════════════

model Table {
  id        String      @id @default(cuid())
  tenantId  String
  pdvId     String
  number    Int
  sector    String      // "Salão", "Varanda", "Área Externa"
  capacity  Int         @default(4)
  status    TableStatus @default(AVAILABLE)
  qrCode    String      @unique // token único que vai na URL do QR Code
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  pdv       PDV         @relation(fields: [pdvId], references: [id])
  sessions  TableSession[]
  orders    Order[]

  @@unique([pdvId, number])
  @@index([tenantId])
  @@index([qrCode])
}

// Uma "sessão de mesa" = abertura até fechamento da conta
model TableSession {
  id          String    @id @default(cuid())
  tenantId    String
  tableId     String
  waiterId    String?   // garçom responsável
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  totalAmount Decimal?  @db.Decimal(10, 2)
  notes       String?

  table       Table     @relation(fields: [tableId], references: [id])
  waiter      User?     @relation(fields: [waiterId], references: [id])
  orders      Order[]

  @@index([tenantId])
  @@index([tableId])
}

// ══════════════════════════════════════════════════════════
// CARDÁPIO
// ══════════════════════════════════════════════════════════

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    // "Hambúrgueres", "Pizzas", "Bebidas"
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@index([tenantId])
}

model Product {
  id              String    @id @default(cuid())
  tenantId        String
  categoryId      String
  name            String
  description     String?
  ingredients     String[]
  price           Decimal   @db.Decimal(10, 2)
  comparePrice    Decimal?  @db.Decimal(10, 2) // preço "de" para mostrar desconto
  image           String?
  images          String[]
  sku             String?
  isFeatured      Boolean   @default(false)
  isBestSeller    Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  soldCount       Int       @default(0)   // contador de vendas para ranking
  preparationTime Int?                    // minutos estimados de preparo
  tags            String[]
  aiDescription   String?   // descrição gerada por IA

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  category        Category           @relation(fields: [categoryId], references: [id])
  addonGroups     ProductAddonGroup[]
  orderItems      OrderItem[]
  stocks          Stock[]
  marketplaceMappings MarketplaceProductMapping[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([isActive, tenantId])
}

// Grupos de adicionais: "Ponto da carne", "Adicionais", "Molhos"
model AddonGroup {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  minSelect  Int       @default(0) // mínimo de seleções (0 = opcional)
  maxSelect  Int       @default(1) // máximo de seleções
  isRequired Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  products   ProductAddonGroup[]
  addons     Addon[]

  @@index([tenantId])
}

// Relação N:N entre produtos e grupos de adicionais
model ProductAddonGroup {
  productId    String
  addonGroupId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)

  @@id([productId, addonGroupId])
}

// Itens dentro de um grupo: "Mal passado", "Bacon", "Cheddar"
model Addon {
  id           String     @id @default(cuid())
  tenantId     String
  addonGroupId String
  name         String
  price        Decimal    @db.Decimal(10, 2) @default(0)
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  orderItemAddons OrderItemAddon[]

  @@index([tenantId])
  @@index([addonGroupId])
}

// ══════════════════════════════════════════════════════════
// ESTOQUE
// ══════════════════════════════════════════════════════════

model Stock {
  id          String   @id @default(cuid())
  tenantId    String
  pdvId       String
  productId   String
  quantity    Decimal  @db.Decimal(10, 3) @default(0)
  minQuantity Decimal? @db.Decimal(10, 3) // alerta de estoque baixo
  unit        String   @default("UN")     // UN, KG, L, etc.
  updatedAt   DateTime @updatedAt

  pdv         PDV      @relation(fields: [pdvId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  movements   StockMovement[]

  @@unique([pdvId, productId])
  @@index([tenantId])
}

// Histórico imutável de movimentações de estoque.
// Toda alteração de Stock.quantity (venda, estorno por cancelamento,
// ajuste manual do lojista) gera um registro aqui — nunca editar/excluir.
enum StockMovementType {
  SALE          // baixa automática ao criar pedido
  CANCEL_REFUND // devolução automática ao cancelar pedido (estorno)
  MANUAL_IN     // entrada manual (compra, reposição)
  MANUAL_OUT    // saída manual (perda, quebra, ajuste de inventário)
  ADJUSTMENT    // correção/definição direta de quantidade pelo lojista
}

model StockMovement {
  id           String            @id @default(cuid())
  tenantId     String
  stockId      String
  productId    String
  pdvId        String
  orderId      String?           // presente quando vier de venda/estorno
  type         StockMovementType
  quantity     Decimal           @db.Decimal(10, 3) // sempre positivo; o sinal é dado por `type`
  balanceAfter Decimal           @db.Decimal(10, 3) // quantidade resultante após o movimento
  userId       String?           // quem fez o ajuste manual (null = automático/sistema)
  reason       String?
  createdAt    DateTime          @default(now())

  stock        Stock             @relation(fields: [stockId], references: [id], onDelete: Cascade)
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([stockId])
  @@index([orderId])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════
// CLIENTES
// ══════════════════════════════════════════════════════════

model Customer {
  id              String    @id @default(cuid())
  tenantId        String
  name            String?
  phone           String    // identificador principal (formato: 5511999999999)
  email           String?
  cpf             String?
  address         Json?     // endereço padrão para delivery

  // Verificação por OTP
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  otpCode         String?   // armazenar HASH, nunca o código em si
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)

  // Fidelidade e cashback
  loyaltyPoints   Int       @default(0)
  cashbackBalance Decimal   @db.Decimal(10, 2) @default(0)

  // Estatísticas
  totalOrders     Int       @default(0)
  totalSpent      Decimal   @db.Decimal(10, 2) @default(0)
  lastOrderAt     DateTime?

  isActive        Boolean   @default(true)

  // LGPD
  lgpdConsent     Boolean   @default(false)
  lgpdConsentAt   DateTime?
  anonymizedAt    DateTime? // se preenchido, dados foram anonimizados

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  orders          Order[]
  loyaltyTxs      LoyaltyTransaction[]
  cashbackTxs     CashbackTransaction[]
  reviews         Review[]

  @@unique([phone, tenantId])
  @@index([tenantId])
  @@index([phone])
}

// ══════════════════════════════════════════════════════════
// PEDIDOS
// ══════════════════════════════════════════════════════════

model Order {
  id             String        @id @default(cuid())
  tenantId       String
  pdvId          String?
  tableId        String?
  tableSessionId String?
  customerId     String?
  waiterId       String?       // garçom responsável
  createdById    String?       // usuário do sistema que criou

  // Número legível do pedido (ex: #0042)
  // Sequencial por tenant, não global
  orderNumber    Int

  type           OrderType
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  notes          String?       // observações gerais do pedido

  // Rodada de preparo atual (balcão/mesa). Incrementa toda vez que um
  // pedido já ENTREGUE é reaberto para adicionar itens — os OrderItems
  // criados a partir daí levam esse mesmo número em `OrderItem.kitchenRound`,
  // permitindo que o card do Kanban mostre só o que falta preparar sem
  // mexer no total/itens antigos do pedido (que seguem valendo pra fatura).
  kitchenRound   Int           @default(0)

  // ─────────────────────────────────────────────────
  // VALORES: calculados 100% server-side
  // NUNCA aceitar estes valores vindos do frontend
  // ─────────────────────────────────────────────────
  subtotal       Decimal       @db.Decimal(10, 2)
  deliveryFee    Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount Decimal       @db.Decimal(10, 2) @default(0)
  cashbackUsed   Decimal       @db.Decimal(10, 2) @default(0)
  total          Decimal       @db.Decimal(10, 2)

  // Cupom aplicado
  couponId       String?
  couponCode     String?
  couponDiscount Decimal?      @db.Decimal(10, 2)

  // Entrega
  deliveryAddress Json?
  deliveryBairro  String?
  estimatedDeliveryAt DateTime?

  // Pagamento em dinheiro
  changeFor      Decimal?      @db.Decimal(10, 2) // troco para quanto

  // Timestamps de status
  confirmedAt    DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  pdv            PDV?          @relation(fields: [pdvId], references: [id])
  table          Table?        @relation(fields: [tableId], references: [id])
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  waiter         User?         @relation("AssignedWaiter", fields: [waiterId], references: [id])
  createdBy      User?         @relation("CreatedBy", fields: [createdById], references: [id])
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  stockMovements StockMovement[]
  review         Review?
  marketplaceOrder MarketplaceOrder?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([pdvId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String

  // Snapshot: guardamos nome e preço no momento do pedido
  // porque o preço pode mudar depois
  productName  String
  productPrice Decimal  @db.Decimal(10, 2)

  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2) // preço unitário + adicionais
  totalPrice   Decimal  @db.Decimal(10, 2) // unitPrice × quantity
  notes        String?  // "sem cebola", "bem passado"

  // Em qual rodada de preparo este item foi criado (ver Order.kitchenRound).
  // 0 = rodada original do pedido. Usado só para o Kanban decidir o que
  // exibir no card depois que um pedido entregue é reaberto — não afeta
  // total, faturamento ou histórico.
  kitchenRound Int      @default(0)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
  addons       OrderItemAddon[]

  @@index([orderId])
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  addonId     String
  addonName   String    // snapshot do nome no momento do pedido
  addonPrice  Decimal   @db.Decimal(10, 2)

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon       Addon     @relation(fields: [addonId], references: [id])
}

// Histórico de mudanças de status (para rastreabilidade)
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  userId    String?
  notes     String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?       @relation("StatusHistoryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
}

// ══════════════════════════════════════════════════════════
// CONEXÃO OAUTH COM MERCADO PAGO (Mercado Pago Connect)
// Substitui o modelo de colar access_token manualmente.
// ══════════════════════════════════════════════════════════

// Conexão do tenant com o Stripe Connect (OAuth padrão, igual ao MP).
model StripeConnection {
  id                String    @id @default(cuid())
  tenantId          String    @unique

  stripeUserId      String    // acct_xxx — a conta conectada do tenant
  publishableKey    String?   // chave pública, se vier no token exchange

  // Sensível — criptografado em repouso (AES-256-GCM)
  accessTokenEnc    String
  refreshTokenEnc   String?

  scope             String?
  livemode          Boolean   @default(true)

  connectedAt       DateTime  @default(now())
  connectedByUserId String?
  revokedAt         DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([stripeUserId])
}

// Cadastro do tenant na Efí Bank. Diferente do MP/Stripe, a Efí não tem
// fluxo de OAuth pra plataformas terceiras — o tenant precisa abrir a
// própria conta Efí, criar uma aplicação lá, e colar aqui o Client ID e
// Client Secret dela (ver lib/efi/tenant-client.ts).
model EfiConnection {
  id                  String    @id @default(cuid())
  tenantId            String    @unique

  // Sensível — criptografado em repouso (AES-256-GCM)
  clientIdEnc         String
  clientSecretEnc     String

  // Identificador da conta pro Efí.js (tokenização de cartão no
  // navegador) — não é sensível, é um valor público.
  accountIdentifier   String?

  sandbox             Boolean   @default(true)

  connectedAt         DateTime  @default(now())
  connectedByUserId   String?
  revokedAt           DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model MercadoPagoConnection {
  id                String    @id @default(cuid())
  tenantId          String    @unique

  mpUserId          String
  publicKey         String

  // Sensível — criptografado em repouso (AES-256-GCM)
  accessTokenEnc    String
  refreshTokenEnc   String

  tokenType         String    @default("bearer")
  scope             String?
  expiresAt         DateTime

  liveMode          Boolean   @default(true)

  connectedAt       DateTime  @default(now())
  connectedByUserId String?
  lastRefreshedAt   DateTime?
  revokedAt         DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([mpUserId])
}

// ── WhatsApp Chat ──────────────────────────────────────────────────────────────
model WhatsappChat {
  id          String   @id @default(cuid())
  tenantId    String
  phone       String
  contactName String?
  lastMessage String?
  lastMessageAt DateTime?
  unreadCount Int      @default(0)
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  messages  WhatsappMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([lastMessageAt])
}

model WhatsappMessage {
  id        String   @id @default(cuid())
  chatId    String
  tenantId  String
  body      String
  fromMe    Boolean  @default(false)
  status    String   @default("received") // received, sent, read, failed
  msgId     String?  // ID da mensagem no WhatsApp
  sentById  String?  // usuário que enviou (quando fromMe=true)
  mediaUrl      String? // data URL (base64) ou link do arquivo de mídia
  mediaType     String? // image, video, audio, document, sticker
  mediaMimeType String?
  mediaFileName String?
  createdAt DateTime @default(now())

  chat   WhatsappChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sentBy User?        @relation("SentMessages", fields: [sentById], references: [id])

  @@index([chatId])
  @@index([tenantId])
}



model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  orderId           String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)

  // Mercado Pago — PIX
  mercadoPagoId     String?       @unique
  mercadoPagoStatus String?
  pixQrCode         String?       // código copia-e-cola
  pixQrCodeBase64   String?       // imagem base64 do QR Code
  pixExpiresAt      DateTime?

  // Mercado Pago — Checkout Pro (link de pagamento)
  // Usado tanto para o link enviado via WhatsApp (dashboard) quanto para
  // cartão no cardápio digital (Checkout Pro redireciona para página do MP)
  preferenceId      String?       // ID da Preference no MP
  checkoutUrl       String?       // link de pagamento (init_point)

  // Mercado Pago — Checkout Transparente (cartão online no storefront)
  installments      Int?
  cardLastDigits    String?
  cardBrand         String?       // visa, mastercard, etc

  // Dinheiro
  changeAmount      Decimal?      @db.Decimal(10, 2)

  // Marca pagamentos definidos no momento da criação do pedido (PDV/Mesa
  // com "pagar agora" selecionado). Usado para esconder a opção de trocar
  // forma de pagamento, já que o método foi escolhido e confirmado na hora.
  setAtOrderCreation Boolean      @default(false)

  // Dados brutos do webhook (para auditoria)
  webhookData       Json?

  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  refundAmount      Decimal?      @db.Decimal(10, 2)
  refundReason      String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  order             Order         @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([mercadoPagoId])
  @@index([status])
}

// ══════════════════════════════════════════════════════════
// ENTREGA
// ══════════════════════════════════════════════════════════

model DeliveryZone {
  id         String   @id @default(cuid())
  tenantId   String
  type       String   // BAIRRO, CEP_RANGE, RADIUS
  name       String?  // nome amigável: "Centro e adjacências"
  bairro     String?
  cepStart   String?
  cepEnd     String?
  radiusKm   Decimal? @db.Decimal(6, 2)
  fee        Decimal  @db.Decimal(10, 2) @default(0)
  freeAbove  Decimal? @db.Decimal(10, 2) // entrega grátis acima de X
  minOrder   Decimal? @db.Decimal(10, 2)
  maxTime    Int?     // tempo máximo em minutos
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════
// CUPONS
// ══════════════════════════════════════════════════════════

model Coupon {
  id                    String     @id @default(cuid())
  tenantId              String
  code                  String     // sempre em maiúsculas
  description           String?
  type                  CouponType
  value                 Decimal    @db.Decimal(10, 2) // % ou R$
  minOrderValue         Decimal?   @db.Decimal(10, 2)
  maxDiscount           Decimal?   @db.Decimal(10, 2) // teto de desconto em %
  usageLimit            Int?       // total de usos permitidos
  usageCount            Int        @default(0)
  usageLimitPerCustomer Int        @default(1)
  startsAt              DateTime?
  expiresAt             DateTime?
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant                Tenant     @relation(fields: [tenantId], references: [id])
  orders                Order[]

  @@unique([code, tenantId])
  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════
// FIDELIDADE E CASHBACK
// ══════════════════════════════════════════════════════════

model LoyaltyConfig {
  id              String  @id @default(cuid())
  tenantId        String  @unique
  pointsPerReal   Decimal @db.Decimal(10, 2) @default(1) // pontos a cada R$ 1
  redeemEvery     Int     @default(100) // a cada 100 pontos...
  redeemValue     Decimal @db.Decimal(10, 2) @default(5) // ...vale R$ 5,00
  minPointsRedeem Int     @default(100)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant  @relation(fields: [tenantId], references: [id])
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  orderId     String?
  type        String   // EARN, REDEEM, EXPIRE, ADJUST
  points      Int      // positivo = ganhou, negativo = usou
  balance     Int      // saldo após a transação
  description String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

model CashbackConfig {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  percentage    Decimal  @db.Decimal(5, 2)  // ex: 5.00 = 5%
  validityDays  Int      @default(30)
  maxCashback   Decimal? @db.Decimal(10, 2) // teto de cashback por pedido
  minOrderValue Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model CashbackTransaction {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  orderId    String?
  type       String   // EARN, USE, EXPIRE
  amount     Decimal  @db.Decimal(10, 2) // positivo = ganhou, negativo = usou
  balance    Decimal  @db.Decimal(10, 2)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([tenantId])
}

