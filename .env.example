# ─────────────────────────────────────────────
# BANCO DE DADOS
# Obtenha no Neon (neon.tech) ou Supabase
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/meucardapio?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/meucardapio?sslmode=require"

# ─────────────────────────────────────────────
# SEGURANÇA — NOVAS VARIÁVEIS OBRIGATÓRIAS
# ENCRYPTION_KEY: gere com: openssl rand -hex 32
ENCRYPTION_KEY=""
# OTP_SALT: gere com: openssl rand -hex 16
OTP_SALT=""

# ─────────────────────────────────────────────
# AUTH.JS (NextAuth v5)
# Gere com: openssl rand -base64 32
# ─────────────────────────────────────────────
AUTH_SECRET="gere-aqui-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# REDIS
# Obtenha no Upstash (upstash.com) - gratuito até 10k req/dia
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# ─────────────────────────────────────────────
# STORAGE S3 COMPATÍVEL
# Use Cloudflare R2 (gratuito até 10GB) ou AWS S3
# ─────────────────────────────────────────────
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="meucardapio-uploads"
S3_REGION="auto"
S3_ENDPOINT="https://xxxxx.r2.cloudflarestorage.com"
NEXT_PUBLIC_CDN_URL="https://cdn.seudominio.com"

# ─────────────────────────────────────────────
# MERCADO PAGO
# Obtenha em: mercadopago.com.br/developers
# ─────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Mercado Pago Connect (OAuth) — usado para PIX/cartão dos clientes de
# CADA restaurante (substitui o antigo fluxo de colar token manualmente).
# São credenciais da PLATAFORMA: crie/edite a aplicação em
# mercadopago.com.br/developers/panel/app, copie Client ID e Client Secret,
# e HABILITE "PKCE" nas configurações da aplicação (obrigatório desde 2024).
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""

# Stripe Connect (OAuth) — usado para cartão dos clientes de CADA
# restaurante, alternativa ao Mercado Pago. São credenciais da
# PLATAFORMA: crie/edite a aplicação em dashboard.stripe.com/settings/connect,
# copie a Secret Key da plataforma e o Client ID do OAuth (em
# dashboard.stripe.com/settings/applications).
STRIPE_SECRET_KEY=""
STRIPE_CONNECT_CLIENT_ID=""
# Webhook (config única, veja app/api/webhooks/stripe/route.ts para o
# passo a passo — precisa marcar "Listen to events on Connected accounts"):
STRIPE_WEBHOOK_SECRET=""

# EFÍ BANK como opção de recebimento dos TENANTS (PIX/cartão dos clientes
# de cada restaurante) NÃO usa env var — diferente do MP/Stripe, a Efí não
# tem OAuth pra plataformas terceiras. Cada tenant cadastra o próprio
# Client ID/Secret direto no dashboard (Configurações > Pagamentos),
# guardado criptografado no banco (tabela EfiConnection).

# ─────────────────────────────────────────────
# EFÍ BANK (ex-Gerencianet) — API Cobranças
# Usada SÓ pra cobrança recorrente do próprio plano PRO da plataforma
# (assinatura da conta do tenant). Os pagamentos dos tenants pros clientes
# deles continuam 100% no Mercado Pago, acima.
# Obtenha em: sejaefi.com.br > API > Aplicações > (sua aplicação) >
# ative "Billings API" (Cobranças).
# ─────────────────────────────────────────────
EFI_CLIENT_ID=""
EFI_CLIENT_SECRET=""
# "true" (padrão) usa o ambiente de homologação; troque para "false" em
# produção. Precisa bater com NEXT_PUBLIC_EFI_SANDBOX abaixo.
EFI_SANDBOX="true"

# Identificador de Conta da Efí (API > Introdução > Identificador de Conta).
# NÃO é o client_id/secret acima — é um código público usado só no
# navegador do pagador pra gerar o payment_token (equivalente à Public Key
# do MP). É seguro expor via NEXT_PUBLIC_.
NEXT_PUBLIC_EFI_ACCOUNT_IDENTIFIER=""
NEXT_PUBLIC_EFI_SANDBOX="true"

# ─────────────────────────────────────────────
# EVOLUTION API (WhatsApp)
# Auto-hospedado ou serviço gerenciado
# ─────────────────────────────────────────────
EVOLUTION_API_URL="https://evolution.seuservidor.com"
EVOLUTION_API_KEY=""

# ─────────────────────────────────────────────
# IFOOD (Merchant API)
# Credenciais da PLATAFORMA, obtidas após cadastro e homologação no
# Portal do Parceiro iFood (developer.ifood.com.br) — app tipo "Centralizado".
# NUNCA são as credenciais de um restaurante específico: cada loja apenas
# autoriza este app pelo fluxo em /dashboard/settings/integrations.
# ─────────────────────────────────────────────
IFOOD_APP_ID=""
IFOOD_CLIENT_ID=""
IFOOD_CLIENT_SECRET=""
IFOOD_API_BASE_URL="https://merchant-api.ifood.com.br"

# ─────────────────────────────────────────────
# 99FOOD (Open Delivery)
# A 99Food não tem auto-cadastro público de desenvolvedor — a liberação do
# slot de integração é feita pela equipe comercial da 99Food, por loja.
# Confirme a URL/exigências vigentes em developer-food.99app.com antes de
# ativar em produção.
# ─────────────────────────────────────────────
NINETYNINE_FOOD_API_BASE_URL="https://openapi.didi-food.com/v4/opendelivery"

# ─────────────────────────────────────────────
# IA (Opcional - plano Premium)
# ─────────────────────────────────────────────
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ─────────────────────────────────────────────
# EMAIL (Resend - resend.com)
# Gratuito até 3.000 emails/mês
# ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@seudominio.com"

# ─────────────────────────────────────────────
# MONITORAMENTO (Sentry - sentry.io)
# ─────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Meu Cardápio"
CRON_SECRET="gere-com-openssl-rand-base64-32"

# ─────────────────────────────────────────────
# TOKEN DE STATUS DE PEDIDO (VULN-NEW-03)
# Usado para autorizar polling de status sem login do cliente.
# Gere com: openssl rand -hex 32
# ─────────────────────────────────────────────
ORDER_TOKEN_SECRET=""

# ─────────────────────────────────────────────
# DESENVOLVIMENTO LOCAL
# ─────────────────────────────────────────────
NODE_ENV="development"
